# Desktop, iOS Simulator, or Android emulator fallback. Expo exposes EXPO_PUBLIC_*
# values to the JavaScript bundle automatically.
EXPO_PUBLIC_API_BASE_URL=http://127.0.0.1:3000

# For a physical phone on the same Wi-Fi as the API machine, replace the value
# above with the machine's LAN address, for example:
# EXPO_PUBLIC_API_BASE_URL=http://192.168.1.42:3000

# Android Emulator host alias (use this instead of 127.0.0.1 there):
# EXPO_PUBLIC_API_BASE_URL=http://10.0.2.2:3000
